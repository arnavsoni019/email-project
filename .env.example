# Copy this file to `.env` and adjust. Your real `.env` is git-ignored (keep secrets out
# of version control). Anything left unset falls back to the defaults in mailorg/config.py.

# ---- Local LLM (Ollama) ----------------------------------------------------
OLLAMA_HOST=http://localhost:11434
MODEL_LIGHT=gemma4:e4b
MODEL_HEAVY=gemma4:12b-it-qat
EMBED_MODEL=nomic-embed-text

# ---- Storage ---------------------------------------------------------------
# DB_PATH=data/mailorg.db

# ---- Privacy / cloud opt-in ------------------------------------------------
# Master switch. Leave false to stay 100% local. Nothing reaches the cloud while false.
CLOUD_ENABLED=false
#
# THE CEILING. A JSON array of tasks that are *permitted* to use the cloud, e.g.
# ["ask","draft"]. The switch in the Settings screen can turn these on and off, but can
# never add to this list — the server intersects with it on every write and every read.
# Empty = nothing is cloud-eligible and the UI switch is inert.
#
# Sizing note: bulk enrichment (categorise/summarise/triage) is ~178k tokens over a
# 136-message mailbox, and the local models already agree with the big ones on those
# tasks. Leaving them out and allowing only ["ask","draft"] costs ~2k tokens per
# question instead, and keeps every email body on this machine.
CLOUD_ALLOWED_TASKS=[]

# Any OpenAI-compatible endpoint: OpenRouter, DeepSeek direct, Together, ...
# Switching provider is these two lines, not a code change.
# CLOUD_BASE_URL=https://openrouter.ai/api/v1
# CLOUD_MODEL=deepseek/deepseek-chat
#
# Needed only once a cloud task is actually enabled. NEVER commit a real key —
# .env is gitignored; .env.example (this file) is not.
# CLOUD_API_KEY=

# ---- Gmail (OAuth) ---------------------------------------------------------
# Download an OAuth "Desktop app" client secret from Google Cloud and save it here.
GOOGLE_CLIENT_SECRETS=data/client_secret.json
GOOGLE_TOKEN_PATH=data/token.json
